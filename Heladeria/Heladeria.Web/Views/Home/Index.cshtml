@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center my-5">
    
    <h1 class="display-3 text-danger fw-bold">🍦 Heladería Artesanal</h1>
    <p class="lead text-muted fs-4">Los sabores más frescos y deliciosos, creados con amor y tradición.</p>
    
    <hr class="my-4 mx-auto" style="width: 30%; border-top: 3px solid #dc3545;">

    
    <div class="row justify-content-center mt-5">
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0" style="background-color: #fff8f8;">
                <div class="card-body py-4">
                    <div class="fs-1 mb-2">🍫</div>
                    <h3 class="card-title h5 text-danger fw-semibold">Sabores Premium</h3>
                    <p class="card-text text-secondary small">Desde el clásico Dulce de Leche Granizado hasta nuestros chocolates más intensos.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0" style="background-color: #fcfbf4;">
                <div class="card-body py-4">
                    <div class="fs-1 mb-2">🍓</div>
                    <h3 class="card-title h5 text-warning fw-semibold">100% Natural</h3>
                    <p class="card-text text-secondary small">Frutas seleccionadas de estación. Sabores al agua refrescantes y libres de conservantes.</p>
                </div>
            </div>
        </div>
    </div>


    <div class="mt-5">
        <a class="btn btn-danger btn-lg px-5 py-3 shadow-sm rounded-pill fw-bold" href="#">
            🚀 Ver Catálogo de Sabores
        </a>
    </div>
</div>
